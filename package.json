{
  "name": "sema-transparencia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/verificar-build.ts",
    "build": "next build --webpack",
    "lint": "tsx scripts/lint-projeto.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "validate:data": "tsx scripts/validar-dados.ts",
    "collect:q11": "tsx automacao/coletar-q11.ts coleta",
    "collect:q11-content": "tsx automacao/coletar-conteudo-q11.ts",
    "discover:q11": "tsx automacao/coletar-q11.ts descoberta",
    "review": "tsx scripts/mesclar-validacoes.ts",
    "merge:reviews": "tsx scripts/mesclar-validacoes.ts",
    "publish:data": "tsx scripts/publicar-validacoes.ts",
    "publish:reviews": "tsx scripts/publicar-validacoes.ts",
    "export:xlsx": "python scripts/exportar_excel.py",
    "export:evidence": "tsx scripts/gerar-indice-evidencias.ts",
    "export:panel": "tsx scripts/exportar-resultados-painel.ts",
    "prepare:public-data": "tsx scripts/preparar-dados-publicos.ts",
    "prepare:q11-diagnostics": "tsx scripts/preparar-diagnosticos-q11.ts",
    "analisar:q11": "tsx scripts/preparar-diagnosticos-q11.ts",
    "prepare:public-evidence": "tsx scripts/preparar-evidencias-publicas.ts",
    "prepare:public": "npm run prepare:public-evidence && npm run prepare:q11-diagnostics && npm run prepare:public-data",
    "verify:public-evidence": "tsx scripts/verificar-evidencias-publicas.ts",
    "verify:public": "tsx scripts/verificar-publicacao.ts",
    "check:publication": "tsx scripts/verificar-build.ts",
    "qa:ui": "tsx scripts/qa-interface.ts",
    "qa:reviews": "tsx scripts/qa-revisao-local.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "playwright": "1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
